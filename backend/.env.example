# Environment
RENDER=false

# Resend Email Service
RESEND_API_KEY=your_resend_api_key_here
RESEND_SENDER_EMAIL=noreply@mail.deadinternet.dk
RESEND_SENDER_NAME=DeadInternet

# Frontend
FRONTEND_URL=http://localhost:3000

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://dead-inter.vercel.app,https://deadinternet.dk

#JWT
JWT_SECRET_KEY=your_jwt_secret_key_here

# Database (PostgreSQL via Supabase)
user=database_user_here
password=your_supabase_password_here
host=hostname_here
port=port_number_here
dbname=postgres

# Supabase File Storage
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_public_key
